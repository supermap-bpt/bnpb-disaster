CDSE_CLIENT_ID=your-client-id
CDSE_CLIENT_SECRET=your-client-secret
# Your dataspace.copernicus.eu account login - required for /api/download, which
# uses a password-grant token (the catalogue OAuth client above is rejected by
# CDSE's download/zipper service: "Token audience not allowed").
CDSE_USERNAME=your-copernicus-email@example.com
CDSE_PASSWORD=your-copernicus-password
CDSE_IDENTITY_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CATALOGUE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products
CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
CORS_ORIGINS=http://localhost:5173
SNAP_GPT_PATH=/Applications/esa-snap/bin/gpt